%YAML 1.2
---
# wasp / warp: https://github.com/pannous/wasp, the Rust implementation ~/dev/angles/warp (its parser is the reference).
# The word lists between the GENERATED marks come from warp's sources: rerun scripts/update_words.py, don't edit them.
name: Warp
file_extensions:
  - a
  - an
  - ang
  - angl
  - angle
  - wasp
  - warp
first_line_match: ^#!.*\b(wasp|warp)\b
scope: source.warp

variables:
  identifier: '[A-Za-z_][A-Za-z0-9_]*'
  # `-` ends a word: `a-1` is a subtraction
  word_end: '(?![A-Za-z0-9_])'
  word_start: '(?<![A-Za-z0-9_$@&])'
  # a definition's head after its name: `(a: int, f: (int)->int)`, a return type `: list<Node>`, then `:=` or `from`
  parameters: '\((?:[^()]|\([^()]*\))*\)'
  return_type: ':\s*[A-Za-z_\[][\w<>\[\]?|., ]*?'
  definition_head: '\s*(?:{{parameters}}\s*)?(?:{{return_type}}\s*)?(?::=|\bfrom\s)'
  # BEGIN GENERATED by scripts/update_words.py
  # from warp's sources, see SOURCES in scripts/update_words.py; rerun instead of editing
  constant_language: (?:nothing|empty|euler|false|nada|nill|none|null|true|void|nil|nix|nul|tau|yes|no|pi)
  constant_language_glyphs: (?:☑️|✓️|✔️|ø|ε|π|τ|ω|ℯ|ⅈ|∞|⊤|⊥|☑|✅|✓|✔|✗|❌|🗸|🗹)
  variable_language: (?:previous|result|event|super|value|self|this|old|was|it)
  keyword_control: (?:continue|default|finally|warning|assert|elseif|except|return|switch|unless|await|break|catch|check|test|elsif|match|other|panic|raise|throw|times|until|while|yield|case|elif|else|fail|loop|once|then|warn|with|end|for|try|do|go|if|in)
  keyword_function: (?:function|define|func|def|fun|fn)
  keyword_declaration: (?:capability|interface|prototype|typeclass|protocol|feature|aspect|record|struct|class|trait|data|enum)
  keyword_import: (?:include|require|import|use)
  storage_modifier: (?:synchronized|thread_local|constexpr|protected|transient|abstract|constant|external|internal|nonlocal|override|volatile|mutable|private|virtual|atomic|export|extern|global|inline|linear|native|public|shared|static|stored|async|const|final|local|let|mut|val|var)
  keyword_operator_word: (?:approximately|interpret|undefined|contains|includes|divided|greater|missing|through|unknown|absent|equals|failed|modulo|circa|least|minus|down|even|less|most|nand|plus|same|than|upto|and|div|has|mod|not|odd|rem|xor|as|at|be|by|is|of|or|to)
  keyword_operator_word_glyphs: (?:¬|±|²|³|·|×|÷|‐|‑|‒|–|—|―|‖|…|−|√|∛|∧|∨|≈|≟|≠|≡|≤|≥|⊻|⊼|⋀|⋁|⋅|⋍|⌞|⌟|﹦)
  storage_type: (?:character|codepoint|duration|rational|boolean|closure|float32|float64|integer|double|option|string|symbol|array|error|exact|float|tuple|bool|byte|char|date|fast|list|long|node|pair|real|text|unit|any|f32|f64|i16|i32|i64|int|key|map|set|str|u16|u32|u64|i8|u8)
  support_function: (?:is_alphanumeric|round_half_even|is_whitespace|round_half_up|signal_listen|sound_samples|text_coverage|local_offset|random_below|system_value|gpu_compute|starts_with|bits_float|byte_slice|float_bits|gpu_render|map_values|parse_code|certainly|codepoint|ends_with|is_letter|lowercase|page_path|text_form|uppercase|download|fromkeys|index_of|is_alnum|is_alpha|is_digit|is_error|is_space|possibly|reversed|std_pure|average|byte_at|isalnum|isalpha|isdigit|isspace|nearest|ordinal|println|replace|reverse|append|binary|filter|insert|length|notify|random|reduce|remove|sorted|std_io|unwrap|values|chars|clock|clone|count|error|first|floor|items|lower|paint|print|range|round|sleep|slice|split|strip|tuple|upper|ceil|copy|dict|each|exit|find|fold|join|keys|last|list|mean|push|puts|read|size|sort|sqrt|trim|type|abs|add|all|any|bin|chr|cos|exp|get|hex|len|log|map|max|min|now|ord|pop|sin|sum|tan|ln)
  time_units: (?:minutes|seconds|minute|months|second|hours|month|weeks|years|days|hour|week|year|day)
  units: (?:millisecond|centimeter|characters|codepoints|millimeter|kilometer|milligram|kilogram|inches|bytes|meter|metre|pound|feet|foot|gram|inch|mile|yard|lbs|AD|cm|ft|kg|km|lb|mg|mi|mm|ms|yd|K|g|h|m|s)
  keyword_soft: (?:attributes|definition|implements|parameters|broadcast|completes|extension|functions|indexedDB|interrupt|listeners|signature|database|finished|finishes|operator|whenever|changes|classes|effects|exports|extends|members|methods|package|project|request|session|sort_by|storage|trigger|weekday|weekend|before|cancel|change|delete|fields|folder|lambda|outlet|params|prefix|resume|server|signal|suffix|within|above|after|below|click|every|infix|input|mixin|patch|pause|route|serve|where|body|done|emit|ends|fire|from|init|meta|path|post|redo|root|save|send|stop|undo|ask|dir|doc|law|new|put|ref|am|on|pm)
  # END GENERATED

contexts:
  main:
    - include: statements

  statements:
    - include: comments
    - include: strings
    - include: numbers
    - include: groups
    - include: definitions
    - include: keys
    - include: words
    - include: operators

  ##############################################################################
  # comments: `// …` (not glued to an operand: `7//2` and `7 //2` divide, `http://` is no comment), `# …` after a
  # line start or a space, also behind code (also `#!`, `##`, `#use …`), and nesting `/* … */` and `/# … #/`

  comments:
    - match: '(?<=[A-Za-z0-9_)\]] )//(?=\S)'
      scope: keyword.operator.arithmetic.warp
    - match: '(?<![A-Za-z0-9_)\]:])//'
      scope: punctuation.definition.comment.warp
      push: line_comment
    - match: '(?<!\S)(#)(?=[ \t!#]|$|(?:{{keyword_import}}){{word_end}})'
      captures:
        1: punctuation.definition.comment.warp
      push: line_comment
    - match: '/\*'
      scope: punctuation.definition.comment.begin.warp
      push: star_block_comment
    - match: '/#'
      scope: punctuation.definition.comment.begin.warp
      push: hash_block_comment

  line_comment:
    - meta_scope: comment.line.warp
    - match: '$\n?'
      pop: true
    - include: todo

  star_block_comment:
    - meta_scope: comment.block.warp
    - match: '\*/'
      scope: punctuation.definition.comment.end.warp
      pop: true
    - match: '/\*'
      push: star_block_comment
    - include: todo

  hash_block_comment:
    - meta_scope: comment.block.warp
    - match: '#/'
      scope: punctuation.definition.comment.end.warp
      pop: true
    - match: '/#'
      push: hash_block_comment
    - include: todo

  # `todo` and `fixme` in any case, colored by the scheme overlays
  todo:
    - match: '\b(?i:todo|fixme)\b'
      scope: keyword.other.todo.warp

  ##############################################################################
  # strings: "…" interpolates (`${expr}`, `$(expr)`, `\(expr)`; a bare `$name` stays text, decision P6), '…' does not; both escape (`\n`, `\u{e9}`, `\:alpha`);
  # a one-character literal is a codepoint whichever quote it uses; `p's name` is possessive, no quote

  strings:
    - match: "(?<=[A-Za-z0-9_])'s(?= [A-Za-z_])"
      scope: keyword.operator.possessive.warp
    - match: '"(?:[^"\\$]|\\.)"'
      scope: string.quoted.double.warp constant.character.codepoint.warp
    - match: "'(?:[^'\\\\]|\\\\.)'"
      scope: string.quoted.single.warp constant.character.codepoint.warp
    - match: '"'
      scope: punctuation.definition.string.begin.warp
      push: double_quoted
    - match: "'"
      scope: punctuation.definition.string.begin.warp
      push: single_quoted
    - match: '«'
      scope: punctuation.definition.string.begin.warp
      push: guillemet_quoted

  escapes:
    - match: '\\u\{\h+\}|\\:[A-Za-z]+|\\.'
      scope: constant.character.escape.warp

  double_quoted:
    - meta_scope: string.quoted.double.warp
    - match: '"'
      scope: punctuation.definition.string.end.warp
      pop: true
    - match: '\$\{|\\\{'
      scope: punctuation.section.interpolation.begin.warp
      push: brace_interpolation
    - match: '\$\(|\\\('
      scope: punctuation.section.interpolation.begin.warp
      push: paren_interpolation
    - match: '\$\$'
      scope: constant.character.escape.warp
    - include: escapes

  brace_interpolation:
    - clear_scopes: 1
    - meta_scope: meta.interpolation.warp
    - match: '\}'
      scope: punctuation.section.interpolation.end.warp
      pop: true
    - include: statements

  paren_interpolation:
    - clear_scopes: 1
    - meta_scope: meta.interpolation.warp
    - match: '\)'
      scope: punctuation.section.interpolation.end.warp
      pop: true
    - include: statements

  single_quoted:
    - meta_scope: string.quoted.single.warp
    - match: "'"
      scope: punctuation.definition.string.end.warp
      pop: true
    - include: escapes

  guillemet_quoted:
    - meta_scope: string.quoted.other.warp
    - match: '[»«]'
      scope: punctuation.definition.string.end.warp
      pop: true
    - include: escapes

  ##############################################################################
  # numbers: 0x1F, 1_000, 3.14, 1e9, ⅓-style ratios via `/`, ordinals (1st), and units right after (3km, 1000 ms, 2 minutes)

  numbers:
    - match: '{{word_start}}(0[xX]\h[\h_]*|0[bB][01][01_]*|(?:\d[\d_]*(?:\.\d[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d+)?)(?:(st|nd|rd|th){{word_end}}|\s*((?:{{units}}|{{time_units}}){{word_end}}))?'
      captures:
        1: constant.numeric.warp
        2: constant.numeric.suffix.ordinal.warp
        3: keyword.other.unit.warp

  ##############################################################################

  groups:
    - match: '\('
      scope: punctuation.section.group.begin.warp
      push:
        - meta_scope: meta.group.warp
        - match: '\)'
          scope: punctuation.section.group.end.warp
          pop: true
        - include: statements
    - match: '\['
      scope: punctuation.section.brackets.begin.warp
      push:
        - meta_scope: meta.brackets.warp
        - match: '\]'
          scope: punctuation.section.brackets.end.warp
          pop: true
        - include: statements
    - match: '\{'
      scope: punctuation.section.block.begin.warp
      push:
        - meta_scope: meta.block.warp
        - match: '\}'
          scope: punctuation.section.block.end.warp
          pop: true
        - include: statements
    - match: '[)\]}]'
      scope: invalid.illegal.stray-bracket-end.warp

  ##############################################################################
  # definitions: `def square x`, `fn f(x)`, `class Point`, `type Name = text`, getters `area := w*h`, `f(x) := …`,
  # `f(x: int): Node := …`, `f(x: int): int from runtime`, tags `Person { … }`
  # entity.name.function / entity.name.type feed Sublime's symbol index, so F12 (goto_definition) finds them

  definitions:
    - match: '{{word_start}}(enum)\s+({{identifier}})\s*(\{)'
      captures:
        1: keyword.declaration.warp
        2: entity.name.type.warp
        3: punctuation.section.block.begin.warp
      push: enum_body
    - match: '{{word_start}}((?:{{keyword_function}}))\s+({{identifier}})'
      captures:
        1: keyword.declaration.function.warp
        2: entity.name.function.warp
    - match: '{{word_start}}((?:{{keyword_declaration}}))\s+({{identifier}})'
      captures:
        1: keyword.declaration.warp
        2: entity.name.type.warp
    - match: '{{word_start}}(type)\s+([A-Z][A-Za-z0-9_]*)'
      captures:
        1: keyword.declaration.warp
        2: entity.name.type.warp
    - match: '(?<![.:]\s)(?<![.:]){{word_start}}({{identifier}})(?={{definition_head}})'
      scope: entity.name.function.warp
    - match: '(?:^|(?<=[:=(,\[{]))\s*(?!(?:{{keyword_control}}|{{keyword_function}}|{{keyword_declaration}}|{{storage_modifier}}){{word_end}})({{identifier}})(?=\s*\{)'
      captures:
        1: entity.name.tag.warp

  # enum cases, one a line or comma-separated, each maybe with a payload `Number(value: number)`: each case name is
  # a definition (Symbols.tmPreferences indexes entity.name.constant.enum-case for F12)
  enum_body:
    - meta_scope: meta.block.enum.warp
    - match: '\}'
      scope: punctuation.section.block.end.warp
      pop: true
    - include: comments
    - include: groups
    - match: '{{identifier}}'
      scope: entity.name.constant.enum-case.warp
    - match: ','
      scope: punctuation.separator.warp

  # keys: `name: "Alice"`, not `::` or `:=`, not control words (`else: …`)
  keys:
    - match: '{{word_start}}(?!(?:{{keyword_control}}){{word_end}})({{identifier}})\s*(:)(?![:=])'
      captures:
        1: entity.name.key.warp
        2: punctuation.separator.key-value.warp

  ##############################################################################

  words:
    - match: '{{word_start}}(?i:{{constant_language}}){{word_end}}'
      scope: constant.language.warp
    - match: '{{constant_language_glyphs}}'
      scope: constant.language.warp
    - match: '{{word_start}}(?:{{keyword_control}}){{word_end}}'
      scope: keyword.control.warp
    - match: '{{word_start}}(?:{{keyword_function}}){{word_end}}'
      scope: keyword.declaration.function.warp
    - match: '{{word_start}}(?:{{keyword_declaration}}){{word_end}}'
      scope: keyword.declaration.warp
    - match: '{{word_start}}(?:{{keyword_import}}){{word_end}}'
      scope: keyword.control.import.warp
    - match: '{{word_start}}(?:{{storage_modifier}}){{word_end}}'
      scope: storage.modifier.warp
    - match: '{{word_start}}(?:{{keyword_operator_word}}){{word_end}}'
      scope: keyword.operator.word.warp
    - match: '{{keyword_operator_word_glyphs}}'
      scope: keyword.operator.warp
    # `xs.map(f)`, `map(xs, f)`: a call of a word that also names a type (`map`, `text`) is the function
    - match: '(?<=\.)(?:{{support_function}}){{word_end}}|{{word_start}}(?:{{support_function}})(?=\()'
      scope: support.function.builtin.warp
    - match: '{{word_start}}(?:{{storage_type}}){{word_end}}'
      scope: storage.type.warp
    - match: '{{word_start}}(?:{{support_function}}){{word_end}}'
      scope: support.function.builtin.warp
    - match: '{{word_start}}(?:{{variable_language}}){{word_end}}'
      scope: variable.language.warp
    - match: '{{word_start}}(?:{{keyword_soft}}){{word_end}}'
      scope: keyword.other.soft.warp
    - match: '\$(?:{{identifier}}|\d+)'
      scope: variable.parameter.warp
    - match: '@{{identifier}}'
      scope: entity.other.attribute-name.warp
    - match: '&(?={{identifier}})'
      scope: keyword.operator.function-reference.warp
    - match: '{{word_start}}{{identifier}}(?=\()'
      scope: variable.function.warp

  ##############################################################################

  operators:
    - match: ':='
      scope: keyword.operator.definition.warp
    - match: '\|>|\|(?!\|)'
      scope: keyword.operator.pipe.warp
    - match: '!!?(?!=)'
      scope: keyword.operator.run.warp
    - match: '\?\.|\?\?|::|\.\.\.?|->|=>'
      scope: keyword.operator.warp
    - match: '(?:[-+*/%^]|\*\*|&&|\|\||<<|>>)='
      scope: keyword.operator.assignment.augmented.warp
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.warp
    - match: '='
      scope: keyword.operator.assignment.warp
    - match: '&&|\|\|'
      scope: keyword.operator.logical.warp
    - match: '\+\+|--|\*\*|//|[-+*/%^×÷]'
      scope: keyword.operator.arithmetic.warp
    - match: '[#?:]'
      scope: keyword.operator.warp
    - match: '[,;]'
      scope: punctuation.separator.warp
    - match: '\.'
      scope: punctuation.accessor.warp
