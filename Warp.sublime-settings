{
	// warp files: white by day, very dark blue by night (follows the system appearance; schemes built by warp_backgrounds.py)
	"color_scheme": "auto",
	"light_color_scheme": "Warp Day.sublime-color-scheme",
	"dark_color_scheme": "Warp Night.sublime-color-scheme",
	// the font stays the user's (its Latin letters fall back to Helvetica Neue, which has no weight between Regular and
	// Light, both tried); airier instead: unrounded glyph widths (macOS) and more room between lines
	"font_options": ["no_round"],
	"line_padding_top": 3,
	"line_padding_bottom": 3,
}
