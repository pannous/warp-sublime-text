{
	// warp names the place at the end: "<message> at <file>:<line>:<column>";
	// the lookahead captures file, line and column first, then the whole line as the message
	"cmd": ["warp", "$file_name"],
	"working_dir": "$file_path",
	"path": "$HOME/dev/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
	"selector": "source.warp",
	"file_regex": "^(?=.*? at ([^\\s:]+\\.warp):(\\d+):(\\d+))(.*)$"
}
